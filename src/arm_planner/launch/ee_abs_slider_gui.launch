<launch>
  <!-- Absolute slider ranges -->
  <arg name="xyz_min" default="-1.0"/>
  <arg name="xyz_max" default="1.0"/>
  <arg name="rpy_min" default="-3.14"/>
  <arg name="rpy_max" default="3.14"/>

  <!-- Init EE pose (mirrors ee_init_pos_ / ee_init_rpy_ in the controller) -->
  <arg name="init_x"     default="0.446"/>
  <arg name="init_y"     default="0.0"/>
  <arg name="init_z"     default="0.241"/>
  <arg name="init_roll"  default="-1.5707963"/>  <!-- -pi/2 -->
  <arg name="init_pitch" default="0.0"/>
  <arg name="init_yaw"   default="-1.5707963"/>  <!-- -pi/2 -->

  <!-- Publish rate (Hz) — used in "Always Publish" mode -->
  <arg name="rate" default="25.0"/>

  <!-- Topic -->
  <arg name="topic" default="/EEPose_cmd_abs"/>

  <node name="ee_abs_slider_gui" pkg="arm_planner" type="ee_abs_slider_gui.py" output="screen">
    <param name="xyz_min"    value="$(arg xyz_min)"/>
    <param name="xyz_max"    value="$(arg xyz_max)"/>
    <param name="rpy_min"    value="$(arg rpy_min)"/>
    <param name="rpy_max"    value="$(arg rpy_max)"/>
    <param name="init_x"     value="$(arg init_x)"/>
    <param name="init_y"     value="$(arg init_y)"/>
    <param name="init_z"     value="$(arg init_z)"/>
    <param name="init_roll"  value="$(arg init_roll)"/>
    <param name="init_pitch" value="$(arg init_pitch)"/>
    <param name="init_yaw"   value="$(arg init_yaw)"/>
    <param name="rate"       value="$(arg rate)"/>
    <param name="topic"      value="$(arg topic)"/>
  </node>
</launch>
